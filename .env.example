# Скопируйте в .env командой cp .env.example .env и подставьте свои значения

# Уровень логирования DEBUG, INFO, WARNING или ERROR
LOG_LEVEL=INFO

# Подключение к Postgres при запуске приложения без Docker
# В docker compose приложение само ходит на сервис db, а POSTGRES_PORT задаёт порт БД на localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Эти же логин, пароль и имя базы читает контейнер postgres в docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_audio_censor

# Таймаут проверки каждой зависимости в /api/v1/health, секунды
HEALTH_TIMEOUT=2.0

# MLflow использует свою базу, отдельную от базы приложения
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=change-me
MLFLOW_POSTGRES_DB=mlflow

# UI и HTTP API сервера доступны на этом порту localhost
MLFLOW_PORT=5001

# Адрес MLflow для локального запуска приложения
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_MODEL_NAME=toxic-spans-detector
MLFLOW_MODEL_ALIAS=champion

# RabbitMQ для запуска компонентов без Docker, в docker compose они сами ходят на сервис rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Порт Management UI и HTTP API, через него задаётся лимит очереди
RABBITMQ_MANAGEMENT_PORT=15672
# Эти же логин и пароль получает контейнер rabbitmq в docker compose
RABBITMQ_USER=ai_audio_censor
RABBITMQ_PASSWORD=change-me

# Сколько задач может ждать в очереди, при заполнении брокер отказывает в публикации
TASKS_QUEUE_LIMIT=100
# Сколько API ждёт базу и брокер при приёме задачи, секунды
TASKS_TIMEOUT_SECONDS=2.0
# Через сколько секунд клиенту API повторить запрос, когда время разбора очереди оценить нельзя
TASKS_RETRY_AFTER_MAX_SECONDS=30

# Размер пула потоков воркера, столько задач один воркер выполняет одновременно
WORKER_CONCURRENCY=4
# prefetch_count воркера, если не задан, равен размеру пула
WORKER_PREFETCH=
# Длительность inference одной задачи, секунды
INFERENCE_SECONDS=0.2
# Сколько раз задача доставляется воркеру, после этого она уходит в DLQ
TASK_MAX_DELIVERIES=3
# Пауза перед возвратом задачи в очередь после ошибки, секунды
TASK_RETRY_DELAY_SECONDS=1.0
# Сколько воркер ждёт начатые задачи при остановке, секунды
WORKER_GRACEFUL_TIMEOUT=30

# Первая пауза источника после отказа брокера, секунды
SOURCE_INITIAL_DELAY_SECONDS=0.05
# Предельная пауза источника, секунды
SOURCE_MAX_DELAY_SECONDS=5.0
# Как часто источник пишет скорость публикации в лог, секунды
SOURCE_REPORT_SECONDS=1.0
