# Скопируйте в .env командой cp .env.example .env и подставьте свои значения

# Уровень логирования DEBUG, INFO, WARNING или ERROR
LOG_LEVEL=INFO

# Подключение к Postgres при запуске приложения без Docker
# В docker compose приложение само ходит на сервис db, а POSTGRES_PORT задаёт порт БД на localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Эти же логин, пароль и имя базы читает контейнер postgres в docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_audio_censor

# Таймаут проверки каждой зависимости в /api/v1/health, секунды
HEALTH_TIMEOUT=2.0

# MLflow использует свою базу, отдельную от базы приложения
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=change-me
MLFLOW_POSTGRES_DB=mlflow

# UI и HTTP API сервера доступны на этом порту localhost
MLFLOW_PORT=5001

# Адрес MLflow для локального запуска приложения
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_MODEL_NAME=toxic-spans-detector
MLFLOW_MODEL_ALIAS=champion

# RabbitMQ для запуска компонентов без Docker, в docker compose они сами ходят на сервис rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Порт Management UI и HTTP API, через него задаётся лимит очереди
RABBITMQ_MANAGEMENT_PORT=15672
# Эти же логин и пароль получает контейнер rabbitmq в docker compose
RABBITMQ_USER=ai_audio_censor
RABBITMQ_PASSWORD=change-me

# Сколько задач может ждать в очереди, при заполнении брокер отказывает в публикации
TASKS_QUEUE_LIMIT=100
